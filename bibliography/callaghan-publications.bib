  langid = {english},
  keywords = {Climate-change adaptation,Databases,Governance,Interdisciplinary studies,Publication characteristics},
  file = {C\:\\Users\\maxca\\Zotero\\storage\\S7QNQ5G8\\Berrang-Ford et al. - 2021 - A systematic global stocktake of evidence on human.pdf;C\:\\Users\\maxca\\Zotero\\storage\\DH6XTRUZ\\s41558-021-01170-y.html}
}

