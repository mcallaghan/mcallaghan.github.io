@article{luckEvidenceGapIndex2025,
  title = {The Evidence Gap Index: Mapping Evidence Where It Matters for Climate Change Impacts},
  shorttitle = {The Evidence Gap Index},
  author = {L{\"u}ck, Sarah and Callaghan, Max and Schleussner, Carl-Friedrich and Minx, Jan},
